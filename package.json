{
  "name": "foley-works",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local --import tsx --watch server/entry.ts",
    "start:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/entry.ts",
    "dev:all": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "manifests:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/generateManifests.ts",
    "sideload:word": "npm run manifests:generate && office-addin-debugging start dist/manifests/word.xml desktop --app word --no-debug --no-live-reload",
    "unsideload:word": "office-addin-debugging stop dist/manifests/word.xml",
    "sideload:outlook": "npm run manifests:generate && office-addin-debugging start dist/manifests/outlook.xml desktop --app outlook --no-debug --no-live-reload",
    "unsideload:outlook": "office-addin-debugging stop dist/manifests/outlook.xml",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "tauri:dev": "cd desktop && tauri dev"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/lightbox": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/cli": "^2.12.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "cors": "^2.8.6",
    "dockview": "^8.3.1",
    "dockview-react": "^8.3.1",
    "express": "^5.2.1",
    "jotai": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/office-js": "^1.0.610",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "office-addin-debugging": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
