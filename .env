# Public values bundled into the React app. Never put secrets in VITE_ variables.
VITE_APP_NAME=Foley Works
VITE_API_URL=/trpc

# Public USPTO ODP server endpoint. Keep the API key in an ignored local env file.
USPTO_ODP_URL=https://api.uspto.gov/api/v1/patent/applications/

# Manifest template values. Set these per environment before generating manifests.
DEPLOYMENT_ORIGIN=https://localhost:5173
DEPLOYMENT_DISPLAY_NAME=Foley Works
PROVIDER_NAME=Foley Works
WORD_ADDIN_ID=8f4da03a-9e8d-4ba8-93e7-1f5b4a644100
OUTLOOK_ADDIN_ID=8f4da03a-9e8d-4ba8-93e7-1f5b4a644102
